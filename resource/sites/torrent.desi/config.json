{
  "name": "Desitorrents",
  "timezoneOffset": "+0000",
  "schema": "UNIT3D",
  "url": "https://torrent.desi/",
  "icon": "https://torrent.desi/favicon.ico",
  "tags": ["影视", "综合", "印度"],
  "host": "torrent.desi",
  "formerHosts": [
    "desitorrents.tv"
  ],
  "levelRequirements": [{
      "level": "1",
      "name": "PowerUser",
      "interval": "4",
      "uploaded": "1TB",
      "privilege": "Power User Special Forum Acess"
  }, {
      "level": "2",
      "name": "SuperUser",
      "interval": "8",
      "uploaded": "5TB",
      "privilege": "Automatic torrent approvals, Super User Special Forum Acess"
  }, {
      "level": "3",
      "name": "ExtremeUser",
      "interval": "13",
      "uploaded": "20TB",
      "privilege": "Invite forums"
  }, {
      "level": "4",
      "name": "InsaneUser",
      "interval": "26",
      "uploaded": "50TB",
      "privilege": ""
  }, {
      "level": "5",
      "name": "Veteran",
      "interval": "52",
      "uploaded": "100TB",
      "privilege": ""
  }],
  "collaborator": "bright",
  "selectors": {
    "merge": true,
    "userBaseInfo": {
      "merge": true,
      "fields": {
        "name": {
          "selector": ["a[href*='settings']:first"],
          "attribute": "href",
          "switchFilters": [
            ["new URL(query).pathname.split('/')", "(query && query.length>2)?(query[1]):''"],
            ["query ? decodeURI(query.getQueryString('id')):''"]
          ]
        },
        "isLogged": {
          "selector": ["form[action*='logout']"],
          "filters": ["query.length > 0"]
        }
      }
    },
    "userExtendInfo": {
      "merge": true,
      "page": "/$user.name$",
      "fields": {
        "messageCount": {
          "selector": ["circle[fill='transparent']"],
          "filters": ["query.length?11:0"]
        },
        "joinTime": {
          "selector": ["time.profile__registration"],
          "filters": ["query.attr('datetime')"]
        },
        "levelName": {
          "selector": ["span.profile__username a.user-tag__link"],
          "filters": ["query.attr('title')"]
        },
        "uploads": {
          "selector": ["i.fa-upload:contains('Total Uploads') + span"],
          "filters": ["query ? parseInt(query.text().trim().replace(/,/g,'')) : 0"]
        }
      }
    },
    "hnrExtendInfo": {
      "page": "/$user.name$/torrents?unsatisfied=include&perPage=100&hitrun=exclude&immune=exclude",
      "fields": {
        "unsatisfieds": {
          "selector": [".table-responsive tbody tr"],
          "filters": ["query ? query.length : 0"]
        }
      }
    }
  }
}
